# AutoMate — environment template
#
# Everything works with NO environment variables set: the auth secret falls back
# to a dev constant and the database is a local SQLite file at data/automate.auth.db.
# Copy this file to .env.local and fill in what you need, when you need it.

# --- Auth (add these when you want real OAuth) -------------------------------
# Google OAuth client → https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers app (Facebook Login) → https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Optional overrides ------------------------------------------------------
# Defaults: dev secret, http://localhost:3000, data/automate.auth.db
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
AUTH_DB_FILE=
